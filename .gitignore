# ---------------------------------------------------------------------------
# Obsidian — estado local de la interfaz
# Cambia cada vez que abrís, movés o cerrás una pestaña. Es ruido puro en el
# historial y es la principal fuente de conflictos si sincronizás el vault
# entre varias máquinas.
# ---------------------------------------------------------------------------
.obsidian/workspace.json
.obsidian/workspace-mobile.json

# ---------------------------------------------------------------------------
# Obsidian — caché y datos derivados
# Se regeneran solos a partir de las notas.
# ---------------------------------------------------------------------------
.obsidian/cache
.obsidian/*.mdb

# ---------------------------------------------------------------------------
# Obsidian Sync — estado de sincronización
# Es específico de este dispositivo y de tu cuenta. Nunca debe viajar al repo.
# ---------------------------------------------------------------------------
.obsidian/sync.json
.obsidian/sync-state.json

# ---------------------------------------------------------------------------
# Papelera de Obsidian
# Notas que borraste desde la app; el historial de git ya cumple ese papel.
# ---------------------------------------------------------------------------
.trash/

# ---------------------------------------------------------------------------
# Archivos del sistema operativo
# ---------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
desktop.ini
*~
*.swp

# ---------------------------------------------------------------------------
# Lo que SÍ se versiona a propósito (no borrar de aquí):
#   .obsidian/app.json           preferencias del editor
# tema y tipografía
.obsidian/appearance.json    
# qué plugins tenés activos
.obsidian/core-plugins.json  
# filtros y colores de la vista de grafo
.obsidian/graph.json       
#   .obsidian/templates.json     carpeta de plantillas
#   .obsidian/hotkeys.json       atajos personalizados
# Así, al clonar el vault en otra máquina, recuperás tu configuración.
# ---------------------------------------------------------------------------
